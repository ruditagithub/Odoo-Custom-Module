<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Housekeeping Kanban View -->
    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" group_edit="false" group_delete="false">
                <field name="id"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_to_id"/>
                <field name="cleaning_type"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click mb-3">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top d-flex justify-content-between align-items-start">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" style="font-size: 1.1em;">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body my-2">
                                    <div style="font-weight: bold; color: #4c4c4c;">
                                        <i class="fa fa-bed me-2"/> Room: <field name="room_id"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        Type: <field name="cleaning_type"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="assigned_to_id" widget="many2one_avatar_user"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="badge" 
                                               decoration-muted="state == 'draft'"
                                               decoration-info="state == 'assigned'"
                                               decoration-warning="state == 'cleaning'"
                                               decoration-success="state in ('done', 'inspected')"
                                               decoration-danger="state == 'cancelled'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Housekeeping List/Tree View -->
    <record id="view_hotel_housekeeping_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.tree</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'" decoration-info="state == 'assigned'" decoration-warning="state == 'cleaning'" decoration-success="state in ('done', 'inspected')">
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_to_id" widget="many2one_avatar_user"/>
                <field name="cleaning_type"/>
                <field name="priority" widget="priority"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge" 
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state == 'cleaning'"
                       decoration-success="state in ('done', 'inspected')"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Housekeeping Form View -->
    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" string="Assign" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Cleaning" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-success" invisible="state != 'cleaning'"/>
                    <button name="action_inspect" string="Inspect" type="object" class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('inspected', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,cleaning,done,inspected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="assigned_to_id"/>
                            <field name="cleaning_type"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Notes" name="notes">
                            <field name="notes" placeholder="Specify any comments, issues or details here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Housekeeping Search View -->
    <record id="view_hotel_housekeeping_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.search</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <field name="assigned_to_id"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assigned_to_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="state_assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Cleaning" name="state_cleaning" domain="[('state', '=', 'cleaning')]"/>
                <filter string="Clean / Done" name="state_done" domain="[('state', '=', 'done')]"/>
                <filter string="Inspected" name="state_inspected" domain="[('state', '=', 'inspected')]"/>
                <separator/>
                <filter string="Urgent / High" name="priority_high" domain="[('priority', 'in', ('2', '3'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Room" name="group_by_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Housekeeper" name="group_by_housekeeper" context="{'group_by': 'assigned_to_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'state'}"/>
                    <filter string="Cleaning Type" name="group_by_type" context="{'group_by': 'cleaning_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Housekeeping Window Action -->
    <record id="action_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping Tasks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.housekeeping</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first housekeeping task!
            </p>
        </field>
    </record>
</odoo>
